# ============================================================================
# SERVER-ONLY SECRETS (NEVER EXPOSE TO CLIENT / VITE_* OR ANDROID APK)
# ============================================================================
# GEMINI_API_KEY: Required for server-side Gemini AI API calls (/api/ai/*, /api/news/*).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PADDLE BILLING (WEB / GLOBAL MERCHANT OF RECORD - SERVER-ONLY SECRETS)
PADDLE_ENVIRONMENT="sandbox"
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""

# GOOGLE PLAY BILLING (ANDROID NATIVE - SERVER-ONLY VERIFICATION CREDENTIALS)
GOOGLE_PLAY_PACKAGE_NAME="com.socialsharescheduler.app"
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""
GOOGLE_PLAY_RTDN_WEBHOOK_TOKEN=""

# ============================================================================
# PUBLIC CLIENT CONFIGURATION (SAFE FOR BROWSER / ANDROID APK)
# ============================================================================
# Optional remote backend proxy origin when packaged as a standalone Android APK
VITE_API_BASE_URL=""

# Optional public Google OAuth 2.0 Client ID for Google Drive Readonly Picker
VITE_GOOGLE_CLIENT_ID=""

# Public Paddle Checkout Configuration (Web / Global - No Secret Keys)
VITE_PADDLE_ENV="sandbox"
VITE_PADDLE_CLIENT_TOKEN=""
VITE_PADDLE_PRO_MONTHLY_PRICE_ID=""
VITE_PADDLE_PRO_YEARLY_PRICE_ID=""

# Public Google Play Billing Product SKU Placeholders (Android AAB — replace with real Play Console IDs after creation)
VITE_PLAY_BILLING_MONTHLY_PRODUCT_ID="PRO_MONTHLY"
VITE_PLAY_BILLING_YEARLY_PRODUCT_ID="PRO_YEARLY"


